{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Permissions-Policy", "value": "browsing-topics=(), interest-cohort=(), attribution-reporting=(), run-ad-auction=(), join-ad-interest-group=(), shared-storage=(), geolocation=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: https: data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.ipify.org https://openrouter.ai https://sa-production-244d.up.railway.app; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/health", "destination": "https://sa-production-244d.up.railway.app/health" },
    { "source": "/api/admin/rpc", "destination": "https://sa-production-244d.up.railway.app/api/admin/rpc" },
    { "source": "/api/admin/security", "destination": "https://sa-production-244d.up.railway.app/api/admin/security" },
    { "source": "/api/admin/unquarantine", "destination": "https://sa-production-244d.up.railway.app/api/admin/unquarantine" },
    { "source": "/api/hp/log", "destination": "https://sa-production-244d.up.railway.app/api/hp/log" },
    { "source": "/api/upload", "destination": "https://sa-production-244d.up.railway.app/api/upload" },
    { "source": "/api/media/(.*)", "destination": "https://sa-production-244d.up.railway.app/api/media/$1" },
    { "source": "/media/(.*)", "destination": "https://sa-production-244d.up.railway.app/media/$1" },
    { "source": "/api/(.*)", "destination": "https://sa-production-244d.up.railway.app/api/$1" }
  ]
}
